<?xml version="1.0" encoding="UTF-8"?>
<!--
  code_beautifier reads this file if it exists and skips with a warning when it
  has no <file> elements, so the <file> entry below is load-bearing: without it
  the addon never runs PHPCBF at all.
-->
<ruleset name="drupdater-testbed">
    <description>Fixture ruleset for the drupdater regression testbed.</description>

    <file>web/modules/custom</file>

    <arg name="extensions" value="php,module,inc,install,test,profile,theme"/>
    <arg name="colors"/>

    <rule ref="Drupal"/>
    <rule ref="DrupalPractice"/>
</ruleset>
