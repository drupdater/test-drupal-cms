# Site-specific settings and files.
#
# Two deliberate divergences from drupal/cms's default, both required by
# drupdater -- see the root README.
/sites/*/services*.yml
/sites/*/private

# settings.php is COMMITTED here. drupdater's preflight fails without it, and
# its installer appends an SQLite $databases block to it rather than creating
# the file. Upstream ignores /sites/*/settings*.php outright; we ignore only
# the local variants and the scaffolded default.
/sites/*/settings.local.php
/sites/*/default.settings.php
/sites/*/default.services.yml

# Ignore the files directory's CONTENTS, not the directory itself: a rule that
# excludes a directory makes every negation inside it a no-op, and the
# translations directory has to survive for translations_updater to have a path
# to resolve.
/sites/*/files/*
!/sites/default/files/translations
/sites/default/files/translations/*
!/sites/default/files/translations/.gitkeep

# Test site directories generated by automated testing.
/sites/simpletest

# Dependencies managed by Composer.
/core
/libraries
/modules/contrib
/profiles/contrib
/themes/contrib

# PHP scripts scaffolded into the web root by Drupal core.
/*.php
