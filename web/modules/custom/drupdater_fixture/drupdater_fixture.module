<?php

/**
 * @file
 * Fixture module for the drupdater regression testbed.
 *
 * Everything below violates the Drupal coding standard ON PURPOSE, and every
 * violation is one PHPCBF can fix automatically -- code_beautifier only commits
 * when phpcs reports Totals.Fixable > 0. Do not "clean this up": a tidy file
 * here means the addon silently does nothing and the test stops testing it.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function drupdater_fixture_help($route_name, RouteMatchInterface $route_match) {
   // Wrong indentation: three spaces where the standard wants two.
   $replacements = array(
     'module' => 'drupdater_fixture',
   );

   if ($route_name == 'help.page.drupdater_fixture') {
     return '<p>Fixture module for '.$replacements['module'].'.</p>';
   }
   else if ($route_name == 'help.page.system') {
     return '';
   }

   return NULL;
}

/**
 * Returns the fixture's demo rows.
 *
 * @return array
 *   A list of rows, keyed by machine name.
 */
function drupdater_fixture_rows() {
  $rows = array(
    'first'  => array('label' => 'First',  'weight' => 0),
    'second' => array('label' => 'Second', 'weight' => 10),
  );

  foreach ($rows as $key=>$row) {
    $rows[$key]['id'] = 'drupdater-fixture-'.$key;
  }

  return $rows;
}

/**
 * Holds strings for locale_deploy's custom-translations workflow.
 *
 * locale_deploy extracts translatable strings from modules/custom with potx and
 * writes one translations/custom/custom.LANGCODE.po per enabled language. It
 * registers that directory as a pseudo-project ordered last, so anything in it
 * overrides core and contrib translations. A string only makes it into that
 * file if it appears in a custom module, hence this function -- it is never
 * called, exactly as the module's README suggests.
 *
 * @see https://www.drupal.org/project/locale_deploy
 */
function _drupdater_fixture_never_called(): void {
  // Remember to include context in the options if necessary.
  t('Paragraphs');
}
