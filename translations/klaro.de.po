msgid ""
"This module implements the Open Source Klaro! consent manager utility "
"into Drupal."
msgstr ""
"Dieses Modul implementiert den Open Source Klaro! Consent Manager in "
"Drupal."
msgid ""
"Implements the <a href=\"https://github.com/klaro-org/klaro-js\" "
"target=\"_blank\">Klaro Consent Manager</a> into Drupal."
msgstr ""
"Ermöglicht die Nutzung des <a "
"href=\"https://github.com/klaro-org/klaro-js\" "
"target=\"_blank\">Klaro! Consent Managers</a>."
msgid "Process preprocess_field"
msgstr "Verarbeite preprocess_field"
