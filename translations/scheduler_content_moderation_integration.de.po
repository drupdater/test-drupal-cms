msgid "Publish state"
msgstr "Veröffentlicht"
msgid "Unpublish state"
msgstr "Archiviert"
msgid "Scheduler Content Moderation Integration"
msgstr "Inhaltsmoderationsintegration für Scheduler"
msgid ""
"Scheduler sub-module providing content moderation functionality for "
"publishing/unpublishing."
msgstr ""
"Sub-Modul des Moduls Scheduler, dass den Zeitplaner in das "
"Content-Moderation-Modul integriert."
msgid "Scheduler Moderation"
msgstr "Zeitplanungsmoderation"
msgid ""
"Select list for choosing a state. Defined by Scheduler Content "
"Moderation Integration module."
msgstr ""
"Liste zur Auswahl eines Status. Definiert von Modul Scheduler Content "
"Moderation Integration"
msgid ""
"The scheduled publishing state of %publish_state is not a valid "
"transition from the current moderation state of %content_state for "
"this content."
msgstr ""
"Der geplante Veröffentlichungsstatus von %publish_state ist kein "
"gültiger Übergang vom aktuellen Moderationsstatus %content_state "
"für diesen Inhalt."
msgid ""
"The scheduled un-publishing state of %unpublish_state is not a valid "
"transition from the scheduled publishing state of %publish_state."
msgstr ""
"Der geplante Veröffentlichungsstatus %unpublish_state ist kein "
"gültiger Übergang vom geplanten Veröffentlichungsstatus "
"%publish_state."
msgid ""
"The scheduled un-publishing state of %unpublish_state is not a valid "
"transition from the current moderation state of %content_state for "
"this content."
msgstr ""
"Der geplante Veröffentlichungsstatus von %unpublish_state ist kein "
"gültiger Übergang vom aktuellen Moderationsstatus von %content_state "
"für diesen Inhalt."
msgid ""
"You do not have access to transition from %original_state to "
"%new_state"
msgstr ""
"Sie haben keinen Berechtigung, die Änderung von %original_state in "
"%new_state durchzuführen."
msgid "Scheduled Moderation Publish State"
msgstr "Geplante Moderation Veröffentlichungsstatus"
msgid "The published state the node will be set to."
msgstr "Der Veröffentlichungsstatus, in den der Inhalt gesetzt wird."
msgid "Scheduled Moderation Unpublish State"
msgstr "Geplante Moderation Depublizierungsstatus"
msgid "The unpublished state the node will be set to."
msgstr "Der Zustand depubliziert, in den der Inhalt versetzt werden soll."
msgid "No update required."
msgstr "Keine Aktualisierung erforderlich."
msgid ""
"%publish_state and %unpublish_state fields removed from %entity entity "
"type"
msgstr ""
"%publish_state and %unpublish_statefelder entfernt von %entity entity "
"type"
msgid "%field displayed for: @list"
msgstr "%field displayed für: @list"
msgid "%field hidden for: @list"
msgstr "%field hidden für: @list"
msgid "%field field removed from %entity entity type"
msgstr "%field entfernt aus Entitätstyp %entity"
msgid ""
"%entity entity type updated with %publish_state and %unpublish_state "
"fields for Scheduler Content Moderation Integration."
msgstr ""
"%entity Entitätstyp aktualisiert mit %publish_state und "
"%unpublish_state fields zur Integration des Moduls Scheduler in "
"Content Moderation."
