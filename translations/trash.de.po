msgstr "Veröffentlicht"
msgid "Deleted"
msgstr "Gelöscht"
msgid "Purge"
msgstr "Dauerhaft löschen"
msgid "Unpublished"
msgstr "Nicht veröffentlicht"
msgid "not published"
msgstr "Nicht veröffentlicht"
